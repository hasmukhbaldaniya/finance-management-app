{
  "name": "finance-management-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + Rust desktop client for Finance Management",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:native": "cd native && napi build --platform --release --js index.js --dts index.d.ts",
    "postinstall": "npm run build:native",
    "build:mac": "electron-vite build && electron-builder --mac --arm64",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@napi-rs/cli": "^3.9.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@phosphor-icons/react": "^2.1.10",
    "date-fns": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  }
}
